<launch>
  <include file="$(find ur_gazebo)/launch/inc/load_ur5.launch.xml">
    <arg name="joint_limit_params" value="$(find ur_description)/config/ur5/joint_limits.yaml"/>
    <arg name="kinematics_params" value="$(find ur_description)/config/ur5/default_kinematics.yaml"/>
    <arg name="physical_params" value="$(find ur_description)/config/ur5/physical_parameters.yaml"/>
    <arg name="visual_params" value="$(find ur_description)/config/ur5/visual_parameters.yaml"/>
    <arg name="transmission_hw_interface" value="hardware_interface/EffortJointInterface"/>
  </include>

  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher">
    <param name="publish_frequency" value="50.0"/>
  </node>
  <node pkg="tf2_ros" type="static_transform_publisher" name="camera_tf"
        args="-0.2 0 1.2 0 0.8 0 base_link camera_link" />
  <include file="$(find ur_gazebo)/launch/inc/ur_control.launch.xml">
    <arg name="controller_config_file" value="$(find ur_gazebo)/config/ur5_controllers.yaml"/>
    <arg name="controllers" value="joint_state_controller eff_joint_traj_controller"/>
    <arg name="stopped_controllers" value="joint_group_eff_controller"/>
    <arg name="gazebo_world" value="$(find pick_vision)/worlds/pick_demo.world"/>
    <arg name="gui" value="true"/>
    <arg name="paused" value="false"/>
    <arg name="start_gazebo" value="true"/>
    <arg name="spawn_z" value="0.05"/>
    <arg name="initial_joint_positions" value="-J shoulder_pan_joint 0.0 -J shoulder_lift_joint -0.5 -J elbow_joint 1.2 -J wrist_1_joint -1.8 -J wrist_2_joint 0.0 -J wrist_3_joint 0.0"/>
  </include>
 
<rosparam param="move_group/controller_list" subst_value="True">
    - name: eff_joint_traj_controller
      action_ns: follow_joint_trajectory
      type: FollowJointTrajectory
      joints:
        - shoulder_pan_joint
        - shoulder_lift_joint
        - elbow_joint
        - wrist_1_joint
        - wrist_2_joint
        - wrist_3_joint
  </rosparam>

  <include file="$(find ur5_moveit_config)/launch/moveit_planning_execution.launch">
    <arg name="sim" value="true"/>
  </include>
  <include file="$(find ur5_moveit_config)/launch/moveit_rviz.launch">
    <arg name="config" value="true"/>
  </include>

  <node pkg="pick_vision" type="stand_firm.py" name="stand_firm" output="screen" />

  <node pkg="pick_vision" type="detect_block.py" name="color_detector" output="screen"/>
</launch>
